# Copy to .env for local Docker Compose development.
POSTGRES_USER=atlas_user
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=atlas
DATABASE_URL=postgresql+psycopg://atlas_user:change-this-local-password@postgres:5432/atlas
JWT_SECRET_KEY=generate-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
