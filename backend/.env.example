# ATLAS Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://atlas_user:atlas_password@localhost:5432/atlas

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET_KEY=generate_a_random_secret_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
